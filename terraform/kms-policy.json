{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:GetKeyPolicy",
        "kms:ListResourceTags",
        "kms:CreateGrant",
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:CreateKey",
        "kms:PutKeyPolicy",
        "kms:TagResource",
        "kms:EnableKeyRotation"
      ],
      "Resource": "arn:aws:kms:us-east-1:925445554210:key/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "kms:ListKeys",
        "kms:ListAliases"
      ],
      "Resource": "*"
    }
  ]
}
